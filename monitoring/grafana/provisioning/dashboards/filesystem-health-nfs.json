{
  "id": null,
  "uid": "filesystem-health-nfs",
  "title": "Filesystem Health (with NFS)",
  "tags": [
    "fs_health",
    "nfs",
    "health",
    "filesystem"
  ],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "style": "dark",
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "Free & Used space (%)",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "(1 - fs_share_free_ratio) * 100",
          "legendFormat": "used {{share}}",
          "refId": "A"
        },
        {
          "expr": "fs_share_free_ratio * 100",
          "legendFormat": "free {{share}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Used vs Free (GB)",
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "(fs_share_total_bytes - fs_share_free_bytes) / 1024 / 1024 / 1024",
          "legendFormat": "used {{share}}",
          "refId": "A"
        },
        {
          "expr": "fs_share_free_bytes / 1024 / 1024 / 1024",
          "legendFormat": "free {{share}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "gbytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Read & Write throughput (MB/s)",
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "fs_share_write_throughput_bytes / 1024 / 1024",
          "legendFormat": "write {{share}}",
          "refId": "A"
        },
        {
          "expr": "fs_share_read_unbuffered_throughput_bytes / 1024 / 1024",
          "legendFormat": "read (unbuffered) {{share}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MBps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Small files ops/sec (create & delete)",
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "fs_share_smallfiles_create_ops_per_sec",
          "legendFormat": "create {{share}}",
          "refId": "A"
        },
        {
          "expr": "fs_share_smallfiles_delete_ops_per_sec",
          "legendFormat": "delete {{share}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Small IO latency (ms)",
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "fs_share_small_read_latency_ms",
          "legendFormat": "read {{share}}",
          "refId": "A"
        },
        {
          "expr": "fs_share_small_write_latency_ms",
          "legendFormat": "write {{share}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Directory listing duration (s)",
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "fs_share_dirlist_duration_seconds",
          "legendFormat": "{{share}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "I/O errors (per minute)",
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "rate(fs_share_io_errors_total[5m]) * 60",
          "legendFormat": "{{share}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Connection open latency (ms)",
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "fs_share_connection_open_latency_ms",
          "legendFormat": "{{share}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 150
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "NFS Passive Metrics (client-side)",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "NFS throughput (MB/s)",
      "id": 21,
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "rate(fs_nfs_mount_read_bytes_total[1m]) / 1024 / 1024",
          "legendFormat": "read {{share}} {{mount}}",
          "refId": "A"
        },
        {
          "expr": "rate(fs_nfs_mount_write_bytes_total[1m]) / 1024 / 1024",
          "legendFormat": "write {{share}} {{mount}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MBps",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^read"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^write"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "datasource": null
    },
    {
      "type": "timeseries",
      "title": "NFS ops/sec (READ & WRITE)",
      "id": 22,
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "rate(fs_nfs_op_calls_total{op=\"READ\"}[1m])",
          "legendFormat": "read ops {{share}} {{mount}}",
          "refId": "A"
        },
        {
          "expr": "rate(fs_nfs_op_calls_total{op=\"WRITE\"}[1m])",
          "legendFormat": "write ops {{share}} {{mount}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^read"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^write"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "datasource": null
    },
    {
      "type": "timeseries",
      "title": "NFS metadata ops/sec (GETATTR+LOOKUP+READDIR)",
      "id": 23,
      "gridPos": {
        "x": 12,
        "y": 57,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (share,mount) (rate(fs_nfs_op_calls_total{op=~\"GETATTR|LOOKUP|READDIR\"}[1m]))",
          "legendFormat": "metadata ops {{share}} {{mount}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "datasource": null
    },
    {
      "type": "timeseries",
      "title": "NFS small-files ops/sec (CREATE & REMOVE)",
      "id": 24,
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "rate(fs_nfs_op_calls_total{op=\"CREATE\"}[1m])",
          "legendFormat": "create {{share}} {{mount}}",
          "refId": "A"
        },
        {
          "expr": "rate(fs_nfs_op_calls_total{op=\"REMOVE\"}[1m])",
          "legendFormat": "remove {{share}} {{mount}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^create"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^remove"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "datasource": null
    },
    {
      "type": "timeseries",
      "title": "NFS open/close ops/sec",
      "id": 25,
      "gridPos": {
        "x": 12,
        "y": 64,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "rate(fs_nfs_op_calls_total{op=~\"OPEN|CLOSE\"}[1m])",
          "legendFormat": "open/close {{share}} {{mount}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "datasource": null
    },
    {
      "type": "timeseries",
      "title": "NFS commit ops/sec",
      "id": 26,
      "gridPos": {
        "x": 0,
        "y": 71,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "rate(fs_nfs_op_calls_total{op=\"COMMIT\"}[1m])",
          "legendFormat": "commit {{share}} {{mount}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "datasource": null
    },
    {
      "type": "timeseries",
      "title": "NFS RPC retransmits/sec",
      "id": 27,
      "gridPos": {
        "x": 12,
        "y": 71,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "rate(fs_nfs_rpc_retrans_total[1m])",
          "legendFormat": "rpc retrans/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "datasource": null
    },
    {
      "type": "timeseries",
      "title": "Top NFS ops/sec by op type (top 10)",
      "id": 28,
      "gridPos": {
        "x": 0,
        "y": 78,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "topk(10, sum by (op) (rate(fs_nfs_op_calls_total[1m])))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "datasource": null
    },
    {
      "type": "timeseries",
      "title": "NFS retransmit ratio (%)",
      "id": 29,
      "gridPos": {
        "x": 12,
        "y": 78,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "(rate(fs_nfs_rpc_retrans_total[5m]) / rate(fs_nfs_rpc_calls_total[5m])) * 100",
          "legendFormat": "retrans %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "datasource": null
    }
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  }
}