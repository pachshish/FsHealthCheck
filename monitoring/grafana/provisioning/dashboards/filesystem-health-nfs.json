{
  "id": null,
  "uid": "filesystem-health-nfs",
  "title": "Filesystem Health (with NFS)",
  "tags": [
    "fs_health",
    "nfs",
    "health",
    "filesystem"
  ],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "style": "dark",
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "Free & Used space (%)",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "(1 - fs_share_free_ratio) * 100",
          "legendFormat": "used {{share}}",
          "refId": "A"
        },
        {
          "expr": "fs_share_free_ratio * 100",
          "legendFormat": "free {{share}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Used vs Free (GB)",
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "(fs_share_total_bytes - fs_share_free_bytes) / 1024 / 1024 / 1024",
          "legendFormat": "used {{share}}",
          "refId": "A"
        },
        {
          "expr": "fs_share_free_bytes / 1024 / 1024 / 1024",
          "legendFormat": "free {{share}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "gbytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Read & Write throughput (MB/s)",
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "fs_share_write_throughput_bytes / 1024 / 1024",
          "legendFormat": "write {{share}}",
          "refId": "A"
        },
        {
          "expr": "fs_share_read_unbuffered_throughput_bytes / 1024 / 1024",
          "legendFormat": "read (unbuffered) {{share}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MBps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Small files ops/sec (create & delete)",
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "fs_share_smallfiles_create_ops_per_sec",
          "legendFormat": "create {{share}}",
          "refId": "A"
        },
        {
          "expr": "fs_share_smallfiles_delete_ops_per_sec",
          "legendFormat": "delete {{share}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Small IO latency (ms)",
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "fs_share_small_read_latency_ms",
          "legendFormat": "read {{share}}",
          "refId": "A"
        },
        {
          "expr": "fs_share_small_write_latency_ms",
          "legendFormat": "write {{share}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Directory listing duration (s)",
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "fs_share_dirlist_duration_seconds",
          "legendFormat": "{{share}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "I/O errors (per minute)",
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "rate(fs_share_io_errors_total[5m]) * 60",
          "legendFormat": "{{share}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Connection open latency (ms)",
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "fs_share_connection_open_latency_ms",
          "legendFormat": "{{share}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 150
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "NFS Passive Metrics (client-side)",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "NFS Throughput (READ / WRITE)",
      "description": "Shows real read/write throughput per mount using the exporter metrics fs_nfs_mount_read_throughput_bytes_per_second and fs_nfs_mount_write_throughput_bytes_per_second. This replaces older bytes_total style panels with direct throughput.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "MBps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "fs_nfs_mount_read_throughput_bytes_per_second / 1024 / 1024",
          "legendFormat": "READ {{share}} {{mount}}",
          "refId": "A"
        },
        {
          "expr": "fs_nfs_mount_write_throughput_bytes_per_second / 1024 / 1024",
          "legendFormat": "WRITE {{share}} {{mount}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "NFS Avg RTT (network / RPC latency)",
      "description": "Shows average RPC round trip time for READ and WRITE using fs_nfs_op_avg_rtt_milliseconds. If this rises, it usually points to network latency, packet delay, congestion, or slow NFS RPC response path.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 58
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "fs_nfs_op_avg_rtt_milliseconds{op=\"READ\"}",
          "legendFormat": "READ RTT {{share}} {{mount}}",
          "refId": "A"
        },
        {
          "expr": "fs_nfs_op_avg_rtt_milliseconds{op=\"WRITE\"}",
          "legendFormat": "WRITE RTT {{share}} {{mount}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "NFS Backend Delay (Execute - RTT)",
      "description": "Key diagnostic panel for server or storage-side delay. Calculated as avg execute minus avg RTT. If this grows while retransmissions stay low, the delay usually comes from server processing or storage backend rather than the network.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 58
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "clamp_min(fs_nfs_op_avg_execute_milliseconds{op=\"READ\"} - fs_nfs_op_avg_rtt_milliseconds{op=\"READ\"}, 0)",
          "legendFormat": "READ backend delay {{share}} {{mount}}",
          "refId": "A"
        },
        {
          "expr": "clamp_min(fs_nfs_op_avg_execute_milliseconds{op=\"WRITE\"} - fs_nfs_op_avg_rtt_milliseconds{op=\"WRITE\"}, 0)",
          "legendFormat": "WRITE backend delay {{share}} {{mount}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "NFS Retrans Ratio (network suspicion)",
      "description": "Shows retransmission ratio per operation using fs_nfs_op_retrans_ratio. Values above 0 indicate retries. If this rises together with RTT, that strongly suggests network issues or RPC path instability.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 66
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "fs_nfs_op_retrans_ratio{op=\"READ\"}",
          "legendFormat": "READ retrans {{share}} {{mount}}",
          "refId": "A"
        },
        {
          "expr": "fs_nfs_op_retrans_ratio{op=\"WRITE\"}",
          "legendFormat": "WRITE retrans {{share}} {{mount}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "NFS Network vs Server Delay",
      "description": "Comparison panel to quickly separate network delay from server or storage delay. RTT lines represent network/RPC path latency. Backend delay lines represent execute minus RTT, which points more to server/storage/backend. If RTT rises more than backend delay, suspect network. If backend delay rises while RTT stays reasonable and retrans is low, suspect server or storage.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 74
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "fs_nfs_op_avg_rtt_milliseconds{op=\"READ\"}",
          "legendFormat": "READ network RTT {{share}} {{mount}}",
          "refId": "A"
        },
        {
          "expr": "clamp_min(fs_nfs_op_avg_execute_milliseconds{op=\"READ\"} - fs_nfs_op_avg_rtt_milliseconds{op=\"READ\"}, 0)",
          "legendFormat": "READ server/backend {{share}} {{mount}}",
          "refId": "B"
        },
        {
          "expr": "fs_nfs_op_avg_rtt_milliseconds{op=\"WRITE\"}",
          "legendFormat": "WRITE network RTT {{share}} {{mount}}",
          "refId": "C"
        },
        {
          "expr": "clamp_min(fs_nfs_op_avg_execute_milliseconds{op=\"WRITE\"} - fs_nfs_op_avg_rtt_milliseconds{op=\"WRITE\"}, 0)",
          "legendFormat": "WRITE server/backend {{share}} {{mount}}",
          "refId": "D"
        }
      ]
    }
  ]
}